<?php

/**
 * Stub: Pest global functions.
 *
 * Pest's real signatures type $this via @param-closure-this TestCase (PHPUnit),
 * so PHPStan cannot see Laravel testing methods on $this inside test closures.
 * These stubs override the bindings and avoid referencing Pest classes, which
 * the stub validator cannot resolve. Returns are declared `mixed` because the
 * return values are never used in this project's tests.
 */

/**
 * @param-closure-this \Tests\TestCase $closure
 */
function beforeEach(?\Closure $closure = null): mixed
{
}

/**
 * @param-closure-this \Tests\TestCase $closure
 */
function afterEach(?\Closure $closure = null): mixed
{
}

/**
 * @param-closure-this \Tests\TestCase $closure
 */
function test(?string $description = null, ?\Closure $closure = null): mixed
{
}

/**
 * @param-closure-this \Tests\TestCase $closure
 */
function it(string $description, ?\Closure $closure = null): mixed
{
}
