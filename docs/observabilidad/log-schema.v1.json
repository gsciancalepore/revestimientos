      },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "maxLength": 256
              },
              "context": {
                "type": "object",
                "description": "Contexto de la línea original, pasado por la redacción de datos personales. Los textos van truncados a 256 caracteres."
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
