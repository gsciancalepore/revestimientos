    "webhook.payment_not_approved": {
      "description": "MercadoPago informó un pago cuyo estado no es `approved` (`pending`, `in_process`, `rejected`, `cancelled`). No es una falla: el pedido sigue pendiente y el cliente puede reintentar. `order_id` sale de `external_reference` si es numérico; no se verifica que exista.",
      "level": "info"
    },
