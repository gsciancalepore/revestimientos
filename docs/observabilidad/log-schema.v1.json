  "x-events": {
    "app.exception": {
      "description": "Excepción reportada por Laravel. El detalle va en `error`. `message` solo se conserva si la excepción es propia de la app; en las de base de datos queda `sqlstate`. No se registran 404, 403, 419, validación ni autenticación: su estado está en `http.request`.",
      "level": "error"
    },
    "app.log": {
      "description": "Línea que no es un evento del catálogo (framework, librerías, un Log:: suelto). `message` truncado a 256 caracteres y `context` pasado por la redacción de datos personales, con sus textos truncados. Riesgo residual: el texto no es fijo.",
      "level": "any"
    },
    "checkout.mp_preference_failed": {
      "description": "No se pudo generar la preferencia de pago de MercadoPago; el cliente ve un aviso y puede reintentar. El detalle va en `error` (el mensaje del SDK no se conserva).",
      "level": "error"
    },
    "checkout.payment_started": {
      "description": "El pedido quedó creado y el cliente fue derivado a pagar (preferencia de MercadoPago generada, o instrucciones de transferencia). Si después no hay confirmación, los logs NO distinguen si el cliente abandonó en MercadoPago o si el webhook nunca llegó.",
      "level": "info"
    },
    "checkout.rejected": {
      "description": "El cliente intentó avanzar hacia el pago y no pudo. `motivo`: `carrito_vacio`, `no_comprable` (GET /checkout), `validacion` (con `campos`, nunca valores) o `dominio` (con `detalle`, texto fijo de la app). Un carrito que deja de ser comprable entre el GET y el POST aparece como `no_comprable` y después como `dominio`.",
      "level": "info"
    },
    "http.request": {
      "description": "Resumen de un request HTTP al terminar. Nunca lleva la URL, el query string, el cuerpo, las cookies ni las cabeceras.",
      "level": "info"
    },
    "order.created": {
      "description": "Espejo de la auditoría (`audit_logs`). Se creó un pedido en `pending_payment`. Todavía no descuenta stock.",
      "level": "info"
    },
    "order.paid": {
      "description": "Espejo de la auditoría (`audit_logs`). Pago confirmado: el pedido pasó a `paid` y se descontó stock. `origen` es `mercadopago` (webhook, con `payment_id`) o `manual` (transferencia, `payment_id` null).",
      "level": "info"
    },
    "order.paid_after_cancel": {
      "description": "Espejo de la auditoría (`audit_logs`). Incidente de pago: llegó una confirmación sobre un pedido cancelado. El pedido NO pasa a `paid` y queda trabado a propósito; se resuelve fuera del sistema (devolución con el `payment_id`).",
      "level": "warning"
    },
    "order.payment_amount_mismatch": {
      "description": "Espejo de la auditoría (`audit_logs`). Incidente de pago: MercadoPago cobró un monto distinto del total del pedido. El pedido no se confirma.",
