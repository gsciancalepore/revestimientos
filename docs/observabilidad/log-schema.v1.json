{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revestimientos/observabilidad/log-schema.v1.json",
  "title": "Revestimientos — contrato de logs v1",
  "description": "Una línea de log de Revestimientos (spec observabilidad-01-contrato-logs). Compatibilidad: agregar eventos o atributos opcionales es compatible; quitar, renombrar o cambiar tipo o significado exige v2. La ausencia de un evento no prueba que el hecho no ocurrió.",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "level",
    "event",
    "service",
    "environment",
    "request_id",
    "attributes",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "level": {
      "enum": [
        "debug",
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z_]+)+$",
      "enum": [
        "app.exception",
        "app.log",
        "checkout.mp_preference_failed",
        "checkout.payment_started",
        "checkout.rejected",
        "http.request",
        "order.created",
        "order.paid",
        "order.paid_after_cancel",
        "order.payment_amount_mismatch",
        "order.status_changed",
        "order.stock_negative",
        "order.stock_restored",
        "product.created",
        "product.deactivated",
        "product.price_changed",
        "product.stock_changed",
        "user.created",
        "user.deactivated",
        "user.reactivated",
        "user.role_changed",
        "user.updated",
        "webhook.ignored",
        "webhook.order_not_found",
        "webhook.payment_not_approved",
        "webhook.payment_not_found",
        "webhook.processing_failed",
        "webhook.signature_invalid"
      ]
    },
    "service": {
      "const": "revestimientos"
    },
    "environment": {
      "type": "string"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "attributes": {
      "type": "object"
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "code": {
          "type": [
            "integer",
            "string"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "sqlstate": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^()]*:[0-9]+$"
          }
        }
      },
      "required": [
        "class",
        "code",
        "message",
        "sqlstate",
        "trace"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "http.request"
          }
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string"
              },
              "route": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "integer"
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              },
              "user_id": {
                "type": "integer"
              }
            },
            "required": [
              "method",
              "route",
              "status",
              "duration_ms"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "app.exception"
          }
        }
      },
      "then": {
