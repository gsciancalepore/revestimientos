      "level": "error"
    },
    "webhook.signature_invalid": {
      "description": "Espejo de la auditoría (`audit_logs`). Notificación rechazada con 401 por firma inválida o secreto ausente. `mp_request_id` es la cabecera `x-request-id` de MercadoPago (no confiable).",
      "level": "warning"
